# === Database ===
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lumiris
SPRING_DATASOURCE_USERNAME=lumiris
SPRING_DATASOURCE_PASSWORD=lumiris_local_dev_only

# === Redis ===
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=lumiris_local_dev_only
SPRING_DATA_REDIS_SSL=false

# === Storage (MinIO local — S3-wire-compatible, no AWS dependency) ===
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_ACCESS_KEY_ID=lumiris-app
STORAGE_S3_SECRET_ACCESS_KEY=lumiris_local_dev_only
STORAGE_S3_PATH_STYLE=true
STORAGE_S3_BUCKET_UPLOADS=lumiris-uploads
STORAGE_S3_BUCKET_ASSETS=lumiris-cdn
STORAGE_S3_BUCKET_BACKUPS=lumiris-backups

# === Mail (Mailhog local) ===
MAIL_HOST=localhost
MAIL_PORT=1025

# === Auth ===
JWT_SECRET=local_dev_jwt_secret_at_least_256_bits_long_padding_xxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-fake-local-for-spring-ai-fallback

# === CORS ===
# Keep in sync with the Lumiris-Front surfaces:
#   - Traefik vhosts: ../Lumiris-Front/CLAUDE.md (section "Surfaces")
#   - Local dev ports 3000-3003 match apps/<app>/.env.example PORT
# CorsConfig logs the loaded list on startup ("CORS allowed origins (N): [...]").
CORS_ALLOWED_ORIGINS=https://lumiris.local,https://admin.lumiris.local,https://client.lumiris.local,https://mobile.lumiris.local,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# === OpenTelemetry ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLING=1.0
